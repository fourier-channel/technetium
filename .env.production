# Build-time configuration for the deployed tc.41chan.net bundle.
#
# WRITTEN 2026-08-15 after a rebuild from a clean clone silently fell back to
# the in-repo DEVWEB defaults and broke login: MAS answered "redirect_uri is not
# allowed for this client", because the bundle asked as the wrong client.
#
# These values existed nowhere -- not in the repo, not on the deploy host, only
# baked into a bundle nobody could read. Recovered from the last working build
# and written down so the next rebuild cannot lose them again.
VITE_MAS_CLIENT_ID=000000000000000000000TCWEB
VITE_HOMESERVER=https://41chan.net
